# josho-hr web env (Phase 2 example — do NOT commit a real .env)

# -- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only, never exposed to browser
SUPABASE_SERVICE_ROLE_KEY=

# -- Symmetric encryption (user API keys, HMAC secrets, Gmail passwords) --
# 32 bytes, base64-encoded. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# -- Companion token signing (HS256 JWT, aud='companion') ------------------
# 32+ bytes, base64-encoded. Separate secret from ENCRYPTION_KEY.
COMPANION_TOKEN_SECRET=

# -- n8n outbound signing --------------------------------------------------
N8N_OUTBOUND_HMAC_KEY=

# -- Trial-pool LLM keys (shared across trial users, rate-limited) --------
TRIAL_POOL_GROQ_KEY=
TRIAL_POOL_OPENROUTER_KEY=

# -- Worker ---------------------------------------------------------------
WORKER_BASE_URL=
WORKER_CRON_TOKEN=

# -- Feature kill-switches (see docs/rollback.md) -------------------------
FEATURE_TRIAL_POOL_ENABLED=true
FEATURE_SIJOY_TAX_ENABLED=true
FEATURE_N8N_OUTBOUND_ENABLED=true

# -- App base URL (used in auth redirects, companion downloads) -----------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -- Soft-launch invite gate ----------------------------------------------
# Comma-separated codes (case-insensitive). When any code OR email is set,
# /signup requires either a valid code OR an email on the allowlist below.
# Leave both empty to disable gating (public signup mode).
JOSHO_HR_INVITE_CODES=
# Comma-separated emails that bypass the code requirement entirely.
JOSHO_HR_INVITE_EMAILS=

# -- RLS isolation test (GATE-DATA-02) ------------------------------------
# Used only by web/__tests__/rls.isolation.test.ts. Point at a TEST Supabase
# project, NOT production. The test creates and deletes ephemeral users.
TEST_SUPABASE_URL=
TEST_SUPABASE_SERVICE_ROLE_KEY=
TEST_SUPABASE_ANON_KEY=
